# AI_Video_up
# code・doc・計測 script は入れる。生成物と素材と巨大 binary は入れない。

# Python 環境(requirements.txt から作り直す)
vup/venv/
__pycache__/
*.pyc

# model と TensorRT engine
# 第三者 repo の clone や再取得できる weight、GPU 毎に作り直す engine。
vup/models/
vup/trt_engines/
vfi/models/
vfi/engines/
vfi/onnx/
vfi2/models/
vfi2/engines/
vfi2/onnx/

# 計測の出力・作業場・cache
vfi/out/
vfi/work/
vfi2/out/
vfi2/work/
vup/compare/
vup/compare_msel/
vup/_qcache/

# results は計測記録の構造化 data だけ残し、frame dump は外す
vfi/results/*
!vfi/results/*.json
!vfi/results/*.jsonl
!vfi/results/*.csv
vfi2/results/*
!vfi2/results/*.json
!vfi2/results/*.jsonl
!vfi2/results/*.csv

# 素材の動画と screenshot
*.mkv
*.mp4
*.webm
*.avi
_screenshots/
_screenshots_up/

# frame の生 dump
*.npy
*.npz
*.pkl

# 第三者 tool の丸ごと配置(exe/dll/weight 込み)
realesrgan-ncnn-vulkan-v0.2.0-windows/

# weight・engine・書庫・実行 binary(拡張子での保険)
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.engine
*.7z
*.exe
*.dll

# 計測 script が作る GPU の排他 lock(実行時 file)
vup/GPU_LOCK
vup/GPU_LOCK.*

# repo 全体では除外しているが、この folder では残す
!claude --dangerously-skip-permissions.bat

# 画像は入れない(素材の版権が絡むため)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
