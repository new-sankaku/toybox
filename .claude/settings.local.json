{
  "permissions": {
    "allow": [
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(dir:*)",
      "Bash(echo:*)",
      "Bash(npm run lint:fix:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(mkdir -p /home/user/toybox/Poster/doc)",
      "Bash(cp \"/root/.claude/uploads/23b3ee06-a6e6-58b9-bded-20222ad6b80a/a72d2e9f-poster_forge_1.html\" /home/user/toybox/Poster/poster_forge_1.html)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set CLAUDE_HOOK_TYPE=PreToolUse && node \"%USERPROFILE%/.claude/scripts/log-tool-use.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set CLAUDE_HOOK_TYPE=PostToolUse && node \"%USERPROFILE%/.claude/scripts/log-tool-use.js\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set CLAUDE_HOOK_TYPE=Notification && node \"%USERPROFILE%/.claude/scripts/log-tool-use.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "set CLAUDE_HOOK_TYPE=Stop && node \"%USERPROFILE%/.claude/scripts/log-tool-use.js\""
          }
        ]
      }
    ]
  }
}
